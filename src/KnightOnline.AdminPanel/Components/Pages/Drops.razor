@page "/drops"
@attribute [Authorize]
@rendermode InteractiveServer
@inject ICharacterAdminRepository Repo
@inject AuthenticationStateProvider AuthState

<PageTitle>Monster drops — KO 1453 Admin</PageTitle>
<h1>Monster drops</h1>
<p class="muted">Search by monster name or drop-group ID. Empty search browses every group.</p>
<p class="alert alert-warning">Solo PvE supports R attacks, selected attack skills, stationary retaliation, XP and loot pickup. Drop changes are audited and require a GameServer restart; they are not live-reloaded. Parties, chasing AI, buffs, DoTs and AoE remain unsupported.</p>
<div class="search-row">
    <input class="input" placeholder="Monster name or group ID…" @bind="_term" @onkeydown="KeyDown" />
    <button class="btn btn-primary" disabled="@_busy" @onclick="Search">Search</button>
</div>
@if (_error is not null) { <p class="alert alert-danger">@_error</p> }
@if (_notice is not null) { <p class="alert alert-success">@_notice</p> }
@if (_busy) { <p class="muted">Loading…</p> }
@if (_drop is not null)
{
    <div class="card">
        <h2>Drop group @_drop.Id</h2>
        <p class="muted">Each slot rolls independently from 1 to 10000. 100 = 1%, 10000 = 100%; zero chance disables a slot. Empty fields preserve SQL NULL.</p>
        <p><strong>Slots 1–2 are not direct item IDs:</strong> codes below 100 select procedural grade generation; codes 100+ select a MAKE_ITEM_GROUP (one of 30 entries). Slots 3–5 contain direct ITEM IDs. Coins come from K_MONSTER.iMoney, separately.</p>
        <table class="table">
            <thead><tr><th>Slot</th><th>Resolution</th><th>Item / group code</th><th>Chance (0–10000)</th><th>Rate</th></tr></thead>
            <tbody>
            @for (var n = 0; n < 5; n++)
            {
                var i = n;
                <tr><td>@(i + 1)</td><td>@(i < 2 ? "Production / group" : "Direct ITEM")</td>
                    <td><input class="input" type="number" min="0" @bind="_drop.Items[i]" /></td>
                    <td><input class="input" type="number" min="0" max="10000" @bind="_drop.Chances[i]" /></td>
                    <td>@((_drop.Chances[i].GetValueOrDefault() / 100m).ToString("0.##"))%</td></tr>
            }
            </tbody>
        </table>
        <button class="btn btn-primary" disabled="@_busy" @onclick="Save">Save drop group</button>
        <button class="btn" disabled="@_busy" @onclick="Reload">Discard / reload</button>
        <p class="muted small">Saves validate new references and retain before/after JSON in the audit log. Duplicate IDs and stale edits are rejected. Existing broken references can be disabled without first repairing the entire source catalog.</p>
    </div>
}
@if (_rows is not null)
{
    <table class="table"><thead><tr><th>Drop-group ID</th><th>Monster definitions using this group</th><th></th></tr></thead><tbody>
    @foreach (var row in _rows)
    {
        <tr><td>@row.Id</td><td>@row.Monsters</td><td><button class="btn btn-sm" disabled="@_busy" @onclick="() => Open(row.Id)">Edit</button></td></tr>
    }
    </tbody></table>
    @if (_rows.Count == 0) { <p class="muted">No matching drop groups.</p> }
    <div class="search-row">
        <button class="btn" disabled="@(_busy || _page == 0)" @onclick="Previous">← Previous</button>
        <span>Page @(_page + 1)</span>
        <button class="btn" disabled="@(_busy || !_more)" @onclick="Next">Next →</button>
    </div>
}

@code {
    private string _term = "", _searched = "";
    private string? _error, _notice;
    private bool _busy, _more;
    private int _page;
    private List<DropSummary>? _rows;
    private DropDefinition? _drop;
    protected override Task OnInitializedAsync() => Search();
    private Task KeyDown(KeyboardEventArgs e) => e.Key == "Enter" ? Search() : Task.CompletedTask;
    private async Task Search() { _page = 0; _searched = _term; await Browse(); }
    private async Task Previous() { if (_page > 0) { _page--; await Browse(); } }
    private async Task Next() { if (_more) { _page++; await Browse(); } }
    private async Task Browse() => await Run(async () => {
        var rows = await Repo.SearchDropsAsync(_searched, _page * 50);
        _more = rows.Count > 50; _rows = rows.Take(50).ToList();
    });
    private async Task Open(short id) => await Run(async () => { _drop = await Repo.GetDropAsync(id); });
    private Task Reload() => _drop is null ? Task.CompletedTask : Open(_drop.Id);
    private async Task Save() => await Run(async () => {
        if (_drop is null) return;
        var auth = await AuthState.GetAuthenticationStateAsync();
        _drop.Token = await Repo.SaveDropAsync(_drop, auth.User.Identity?.Name ?? "unknown");
        _notice = "Saved and audited. Restart GameServer to load the changed drop catalog.";
    });
    private async Task Run(Func<Task> action)
    {
        if (_busy) return;
        _busy = true; _error = null; _notice = null;
        try { await action(); } catch (Exception ex) { _error = ex.Message; }
        finally { _busy = false; }
    }
}
