@page "/characters"
@attribute [Authorize]
@rendermode InteractiveServer
@inject ICharacterAdminRepository Repo
@inject NavigationManager Navigation

<PageTitle>Characters — KO 1453 Admin</PageTitle>

<h1>Characters</h1>

<div class="search-row">
    <input class="input" placeholder="Character name (partial ok)…" @bind="_term" @bind:event="oninput" @onkeydown="OnKeyDown" />
    <button type="button" class="btn btn-primary" disabled="@_searching" @onclick="Search">Search</button>
</div>

@if (_error is not null) { <p class="alert alert-danger">@_error</p> }
@if (_searching)
{
    <p class="muted">Searching…</p>
}
else if (_results is null)
{
    <p class="muted">Search for a character to open the editor. Leave the name empty to browse all characters, 50 per page.</p>
}
else if (_results.Count == 0)
{
    <p class="alert alert-warning">No characters matched. (An empty <code>USERDATA</code> table also looks like this.)</p>
}
else
{
    <table class="table">
        <thead>
            <tr><th>Name</th><th>Account</th><th>Nation</th><th>Class</th><th>Level</th><th>Clan</th><th>Zone</th><th>Status</th><th></th></tr>
        </thead>
        <tbody>
            @foreach (var c in _results)
            {
                <tr class="@(c.IsOnline ? "row-online" : "")">
                    <td><a href="characters/@Uri.EscapeDataString(c.Name)">@c.Name</a></td>
                    <td>@(c.AccountId ?? "—")</td>
                    <td><span class="badge badge-nation-@c.Nation">@CharacterClasses.NationName(c.Nation)</span></td>
                    <td>@CharacterClasses.ClassName(c.ClassId)</td>
                    <td>@c.Level</td>
                    <td>@(c.KnightsId == 0 ? "—" : c.KnightsId.ToString())</td>
                    <td>@c.Zone</td>
                    <td>@(c.IsOnline ? "🟢 online" : "⚫ offline")</td>
                    <td><button type="button" class="btn btn-sm" @onclick="@(() => Navigation.NavigateTo($"characters/{Uri.EscapeDataString(c.Name)}"))">Edit</button></td>
                </tr>
            }
        </tbody>
    </table>
    <div class="search-row">
        <button class="btn" disabled="@(_page == 0 || _searching)" @onclick="Previous">← Previous</button>
        <span class="muted">Page @(_page + 1) · showing @(_page * 50 + 1)–@(_page * 50 + _results.Count)</span>
        <button class="btn" disabled="@(!_hasMore || _searching)" @onclick="Next">Next →</button>
    </div>
}

@code {
    private string _term = "";
    private List<CharacterSummary>? _results;
    private bool _searching, _hasMore;
    private int _page;
    private string _searchedTerm = "";
    private string? _error;
    protected override Task OnInitializedAsync() => Search();
    private async Task Previous() { if (_page > 0) { _page--; await Load(); } }
    private async Task Next() { if (_hasMore) { _page++; await Load(); } }

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
            await Search();
    }

    private async Task Search()
    {
        _page = 0; _searchedTerm = _term; await Load();
    }
    private async Task Load()
    {
        _searching = true; _error = null;
        try
        {
            var rows = await Repo.SearchCharactersAsync(_searchedTerm, 51, offset: _page * 50);
            _hasMore = rows.Count > 50;
            _results = rows.Take(50).ToList();
        }
        catch (Exception ex) { _error = ex.Message; }
        finally
        {
            _searching = false;
        }
    }
}
