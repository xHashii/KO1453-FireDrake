@page "/characters/{Name}"
@attribute [Authorize]
@rendermode InteractiveServer
@inject ICharacterAdminRepository Repo
@inject ItemSerialGenerator SerialGenerator
@inject Microsoft.Extensions.Configuration.IConfiguration Config
@inject AuthenticationStateProvider AuthState

<PageTitle>@Name — KO 1453 Admin</PageTitle>

@if (_loading)
{
    <p class="muted">Loading @Name…</p>
}
else if (_character is null)
{
    <h1>@Name</h1>
    <p class="alert alert-warning">Character not found (or the USERDATA item columns are missing — is the game DB converted yet?).</p>
}
else
{
    <div class="char-header">
        <div>
            <h1>@_character.Name
                <span class="badge badge-nation-@_character.Nation">@CharacterClasses.NationName(_character.Nation)</span>
                <span class="badge">@CharacterClasses.ClassName(_character.ClassId)</span>
                @if (_character.IsOnline)
                {
                    <span class="badge badge-online">🟢 ONLINE</span>
                }
            </h1>
            <p class="muted">Account: <b>@(_character.AccountId ?? "unknown")</b> · Zone @_character.Zone · Clan #@_character.KnightsId (fame @_character.Fame) · HP @_character.Hp / MP @_character.Mp · @CharacterClasses.AuthorityName(_character.Authority)</p>
        </div>
        <div class="char-actions">
            <button type="button" class="btn" @onclick="Reload">↻ Reload</button>
            <button type="button" class="btn btn-primary" disabled="@(_character.IsOnline || !_dirty || _saving)" @onclick="Save">
                @(_saving ? "Saving…" : "💾 Save changes")
            </button>
        </div>
    </div>

    @if (_character.IsOnline)
    {
        <p class="alert alert-danger">This character is <b>online</b>. Item edits are disabled — the game server would overwrite them on logout.
           Use “Give item by letter”, or wait until the player logs out.</p>
    }
    @if (!string.IsNullOrEmpty(_error))
    {
        <p class="alert alert-danger">@_error</p>
    }
    @if (!string.IsNullOrEmpty(_notice))
    {
        <p class="alert alert-success">@_notice</p>
    }
    @if (_character.StoredInventorySlots < InventorySlots.Total)
    {
        <p class="alert alert-warning">This database stores @_character.StoredInventorySlots inventory slots (this codebase's save path persists 47 of 73).
           Slots beyond that are shown for completeness but are not written back.</p>
    }

    <div class="editor-layout">
        <div class="editor-main">
            <div class="tabs">
                <button type="button" class="@TabCss("gear")" @onclick="@(() => _tab = "gear")">🧍 Equipment</button>
                <button type="button" class="@TabCss("inv")" @onclick="@(() => _tab = "inv")">🎒 Inventory</button>
                <button type="button" class="@TabCss("bags")" @onclick="@(() => _tab = "bags")">👜 Cospre & Magic Bags</button>
                <button type="button" class="@TabCss("wh")" @onclick="@(() => _tab = "wh")">🏦 Warehouse</button>
            </div>

            @if (_tab == "gear")
            {
                <div class="card">
                    <h3>Equipment (slots 0–13)</h3>
                    <ItemGrid Slots="@Slice(_character.Inventory, 0, 14)" StartSlot="0" Columns="7"
                              SelectedSlot="@SelectedIn(_areaInv)" ItemNames="_itemNames" OnSlotClick="@(i => SelectSlot(_areaInv, i))" />
                    @SlotLabels
                </div>
            }
            else if (_tab == "inv")
            {
                <div class="card">
                    <h3>Inventory (slots 14–41)</h3>
                    <ItemGrid Slots="@Slice(_character.Inventory, 14, 28)" StartSlot="14" Columns="7"
                              SelectedSlot="@SelectedIn(_areaInv)" ItemNames="_itemNames" OnSlotClick="@(i => SelectSlot(_areaInv, i))" />
                </div>
            }
            else if (_tab == "bags")
            {
                <div class="card">
                    <h3>Cospre (42–46) & the bags themselves (47–48)</h3>
                    <ItemGrid Slots="@Slice(_character.Inventory, 42, 7)" StartSlot="42" Columns="7"
                              SelectedSlot="@SelectedIn(_areaInv)" ItemNames="_itemNames" OnSlotClick="@(i => SelectSlot(_areaInv, i))" />
                    <h3>Magic Bag 1 (49–60)</h3>
                    <ItemGrid Slots="@Slice(_character.Inventory, 49, 12)" StartSlot="49" Columns="6"
                              SelectedSlot="@SelectedIn(_areaInv)" ItemNames="_itemNames" OnSlotClick="@(i => SelectSlot(_areaInv, i))" />
                    <h3>Magic Bag 2 (61–72)</h3>
                    <ItemGrid Slots="@Slice(_character.Inventory, 61, 12)" StartSlot="61" Columns="6"
                              SelectedSlot="@SelectedIn(_areaInv)" ItemNames="_itemNames" OnSlotClick="@(i => SelectSlot(_areaInv, i))" />
                </div>
            }
            else
            {
                <div class="card">
                    <h3>Warehouse — page @(_warehousePage + 1)/@WarehousePages <span class="muted">(account-wide)</span></h3>
                    <ItemGrid Slots="@Slice(_character.Warehouse, _warehousePage * 24, 24)" StartSlot="@(_warehousePage * 24)" Columns="8"
                              SelectedSlot="@SelectedIn(_areaWarehouse)" ItemNames="_itemNames" OnSlotClick="@(i => SelectSlot(_areaWarehouse, i))" />
                    <div class="pager">
                        <button type="button" class="btn" disabled="@(_warehousePage == 0)" @onclick="@(() => _warehousePage--)">← Prev page</button>
                        <button type="button" class="btn" disabled="@(_warehousePage >= WarehousePages - 1)" @onclick="@(() => _warehousePage++)">Next page →</button>
                    </div>
                </div>
            }
        </div>

        <aside class="editor-side">
            <div class="card">
                <h3>Character</h3>
                <div class="form-grid">
                    <label>Level <input class="input" type="number" @bind="_character.Level" @bind:after="MarkDirty" /></label>
                    <label>Class ID <input class="input" type="number" @bind="_character.ClassId" @bind:after="MarkDirty" /></label>
                    <label>Coins (inventory) <input class="input" type="number" @bind="_character.Gold" @bind:after="MarkDirty" /></label>
                    <label>Coins (warehouse) <input class="input" type="number" @bind="_character.BankCoins" @bind:after="MarkDirty" /></label>
                    <label>EXP <input class="input" type="number" @bind="_character.Exp" @bind:after="MarkDirty" /></label>
                    <label>Loyalty (NP) <input class="input" type="number" @bind="_character.Loyalty" @bind:after="MarkDirty" /></label>
                    <label>Stat points free <input class="input" type="number" @bind="_character.StatPoints" @bind:after="MarkDirty" /></label>
                    <label>Authority
                        <select class="input" @bind="_character.Authority" @bind:after="MarkDirty">
                            <option value="0">0 — Game Master</option>
                            <option value="1">1 — Player</option>
                            <option value="11">11 — Muted</option>
                            <option value="12">12 — Attack disabled</option>
                            <option value="250">250 — Limited GM</option>
                            <option value="255">255 — BANNED</option>
                        </select>
                    </label>
                </div>
                <div class="form-grid stats">
                    <label>STR <input class="input" type="number" @bind="_character.Stats[0]" @bind:after="MarkDirty" /></label>
                    <label>STA <input class="input" type="number" @bind="_character.Stats[1]" @bind:after="MarkDirty" /></label>
                    <label>DEX <input class="input" type="number" @bind="_character.Stats[2]" @bind:after="MarkDirty" /></label>
                    <label>INT <input class="input" type="number" @bind="_character.Stats[3]" @bind:after="MarkDirty" /></label>
                    <label>CHA <input class="input" type="number" @bind="_character.Stats[4]" @bind:after="MarkDirty" /></label>
                </div>
                @if (_character.MissingColumns.Count > 0)
                {
                    <p class="muted small">This USERDATA lacks: @string.Join(", ", _character.MissingColumns) (those fields won't be saved).</p>
                }
            </div>

            <div class="card">
                <h3>Selected slot</h3>
                @if (!HasSelection)
                {
                    <p class="muted">Click a slot to inspect or edit it.</p>
                }
                else
                {
                    <p class="slot-title">@SelectedDescription</p>
                    <div class="form-grid">
                        <label>Item ID <input class="input" type="number" @bind="_editItemId" /></label>
                        <label>Count <input class="input" type="number" min="0" max="9999" @bind="_editCount" /></label>
                        <label>Durability <input class="input" type="number" @bind="_editDurability" /></label>
                        <label>Expiration (unix) <input class="input" type="number" @bind="_editExpiration" /></label>
                    </div>
                    <p class="muted small">Name: <b>@(_itemNames.TryGetValue(_editItemId, out var n) ? n : "unknown")</b> · Serial: @_editSerial · Expires: @FormatExpiration(_editExpiration)</p>
                    <div class="button-row">
                        <button type="button" class="btn btn-primary" @onclick="ApplySlotEdit">Apply</button>
                        <button type="button" class="btn" @onclick="() => _pickerVisible = true">➕ Add item…</button>
                        <button type="button" class="btn" @onclick="NewSerial">🎲 New serial</button>
                        <button type="button" class="btn @( _moveArmed ? "btn-warning" : "")" @onclick="() => _moveArmed = !_moveArmed">@(_moveArmed ? "Click target slot…" : "↔ Move/swap")</button>
                        <button type="button" class="btn btn-danger-outline" @onclick="ClearSlot">🗑 Clear slot</button>
                    </div>
                }
            </div>

            <div class="card">
                <h3>Give item by letter ✉️ <span class="muted small">(safe for online players)</span></h3>
                <div class="form-grid">
                    <label>Item ID <input class="input" type="number" @bind="_letterItemId" /></label>
                    <label>Count <input class="input" type="number" min="1" max="9999" @bind="_letterCount" /></label>
                    <label>Durability <input class="input" type="number" @bind="_letterDurability" /></label>
                    <label>Coins <input class="input" type="number" min="0" @bind="_letterCoins" /></label>
                    <label>Subject <input class="input" @bind="_letterSubject" /></label>
                    <label>Message <input class="input" @bind="_letterMessage" /></label>
                </div>
                <button type="button" class="btn btn-primary" disabled="@_letterBusy" @onclick="SendLetter">Send letter</button>
                @if (!string.IsNullOrEmpty(_letterResult))
                {
                    <p class="muted small">@_letterResult</p>
                }
            </div>
        </aside>
    </div>

    <ItemPickerDialog @bind-Visible="_pickerVisible" OnPicked="OnItemPicked" />
}

@code {
    [Parameter] public string Name { get; set; } = "";

    private const int WarehousePages = InventorySlots.WarehouseTotal / 24;
    private const int _areaInv = 0;
    private const int _areaWarehouse = 1;

    private CharacterDetails? _character;
    private Dictionary<uint, string> _itemNames = new();
    private bool _loading = true;
    private bool _dirty;
    private bool _saving;
    private string? _error;
    private string? _notice;
    private string _tab = "gear";
    private int _warehousePage;

    private int _selectedArea = -1;
    private int _selectedSlot = -1;
    private bool _moveArmed;
    private uint _editItemId;
    private short _editCount;
    private short _editDurability;
    private uint _editExpiration;
    private ulong _editSerial;

    private bool _pickerVisible;

    private uint _letterItemId;
    private short _letterCount = 1;
    private short _letterDurability;
    private int _letterCoins;
    private string _letterSubject = "A gift";
    private string _letterMessage = "From the GM team";
    private string? _letterResult;
    private bool _letterBusy;

    private bool HasSelection => _character is not null && _selectedArea >= 0 && _selectedSlot >= 0;

    private string SelectedDescription => _selectedArea == _areaInv
        ? InventorySlots.Describe(_selectedSlot)
        : $"Warehouse slot {_selectedSlot}";

    protected override async Task OnParametersSetAsync() => await Reload();

    private async Task Reload()
    {
        _loading = true;
        _error = null;
        _notice = null;
        _selectedArea = -1;
        _selectedSlot = -1;
        _moveArmed = false;

        try
        {
            _character = await Repo.GetCharacterAsync(Name);
            _dirty = false;
            if (_character is not null)
                await RefreshItemNames();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
            _character = null;
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task RefreshItemNames()
    {
        var ids = _character!.Inventory.Concat(_character.Warehouse)
            .Where(s => !s.IsEmpty).Select(s => s.ItemId).Distinct().ToList();
        var names = await Repo.GetItemNamesAsync(ids);
        _itemNames = new Dictionary<uint, string>(names);
    }

    private static IReadOnlyList<ItemSlotData> Slice(ItemSlotData[] all, int start, int count)
    {
        var slice = new ItemSlotData[count];
        Array.Copy(all, start, slice, 0, Math.Min(count, Math.Max(0, all.Length - start)));
        return slice;
    }

    private int SelectedIn(int area) => _selectedArea == area ? _selectedSlot : -1;

    private string TabCss(string tab) => "tab" + (_tab == tab ? " tab-active" : "");

    private void MarkDirty() => _dirty = true;

    private ItemSlotData[] ArrayFor(int area) => area == _areaInv ? _character!.Inventory : _character!.Warehouse;

    private void SelectSlot(int area, int slotIndex)
    {
        if (_character is null)
            return;

        if (_moveArmed && HasSelection && (area != _selectedArea || slotIndex != _selectedSlot))
        {
            // Swap within the same storage area (cross-area moves change who
            // "owns" the item and need extra care - later).
            if (area == _selectedArea)
            {
                var array = ArrayFor(area);
                (array[_selectedSlot], array[slotIndex]) = (array[slotIndex], array[_selectedSlot]);
                _dirty = true;
            }
            _moveArmed = false;
        }

        _selectedArea = area;
        _selectedSlot = slotIndex;

        var slot = ArrayFor(area)[slotIndex];
        _editItemId = slot.ItemId;
        _editCount = slot.Count;
        _editDurability = slot.Durability;
        _editExpiration = slot.ExpirationUnixTime;
        _editSerial = slot.Serial;
    }

    private void ApplySlotEdit()
    {
        if (!HasSelection)
            return;

        var count = _editCount;
        var array = ArrayFor(_selectedArea);
        array[_selectedSlot] = count <= 0 || _editItemId == 0
            ? ItemSlotData.Empty
            : new ItemSlotData(_editItemId, _editDurability, Math.Clamp(count, (short)1, (short)9999), _editSerial, _editExpiration);
        _dirty = true;
    }

    private void ClearSlot()
    {
        if (!HasSelection)
            return;
        ArrayFor(_selectedArea)[_selectedSlot] = ItemSlotData.Empty;
        _editItemId = 0;
        _editCount = 0;
        _editDurability = 0;
        _editExpiration = 0;
        _editSerial = 0;
        _dirty = true;
    }

    private void NewSerial()
    {
        _editSerial = SerialGenerator.Next();
    }

    private async Task OnItemPicked((uint ItemId, short Count, short Durability) picked)
    {
        if (!HasSelection || _character is null)
            return;

        var durability = picked.Durability;
        if (durability == 0)
        {
            var def = await Repo.GetItemAsync(picked.ItemId);
            if (def is not null)
                durability = (short)Math.Clamp(def.Duration, 0, short.MaxValue);
        }

        _editItemId = picked.ItemId;
        _editCount = picked.Count;
        _editDurability = durability;
        _editSerial = SerialGenerator.Next();
        _editExpiration = 0;
        ApplySlotEdit();
        await RefreshItemNames();
    }

    private async Task Save()
    {
        if (_character is null)
            return;

        _saving = true;
        _error = null;
        _notice = null;
        try
        {
            var auth = await AuthState.GetAuthenticationStateAsync();
            var admin = auth.User.Identity?.Name ?? "unknown";
            _character.ConcurrencyToken = await Repo.SaveCharacterAsync(_character, admin);
            _dirty = false;
            _notice = $"Saved. Previous blobs were backed up (audit-logged as {admin}).";
        }
        catch (AdminEditRejectedException ex)
        {
            _error = ex.Message;
        }
        catch (Exception ex)
        {
            _error = $"Save failed: {ex.Message}";
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task SendLetter()
    {
        if (_character is null || _letterItemId == 0)
        {
            _letterResult = "Enter an item ID first.";
            return;
        }

        _letterBusy = true;
        try
        {
            var sender = Config["Admin:GmLetterSender"] ?? "GameMaster";
            var error = await Repo.GiveItemByLetterAsync(
                sender, _character.Name, _letterSubject, _letterMessage,
                _letterItemId, _letterCount, _letterDurability, SerialGenerator.Next(), _letterCoins);
            _letterResult = error.Length == 0 ? "✉️ Letter sent." : error;
        }
        finally
        {
            _letterBusy = false;
        }
    }

    private static string FormatExpiration(uint unix)
        => unix == 0 ? "never" : DateTimeOffset.FromUnixTimeSeconds(unix).ToLocalTime().ToString("yyyy-MM-dd HH:mm");
}

@* Tiny helper so the equipment grid shows what each cell is until a real paper-doll exists. *@
@code {
    private RenderFragment SlotLabels => builder =>
    {
        builder.OpenElement(0, "p");
        builder.AddAttribute(1, "class", "muted small");
        builder.AddContent(2, "0 R.Earring · 1 Helmet · 2 L.Earring · 3 Necklace · 4 Pauldron · 5 Shoulder · 6 R.Hand · 7 Belt · 8 L.Hand · 9 R.Ring · 10 Legs · 11 L.Ring · 12 Gauntlets · 13 Boots");
        builder.CloseElement();
    };
}
