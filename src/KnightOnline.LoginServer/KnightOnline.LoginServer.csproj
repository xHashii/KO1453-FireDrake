<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>KnightOnline.LoginServer</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\KnightOnline.Shared\KnightOnline.Shared.csproj" />
    <ProjectReference Include="..\KnightOnline.Database\KnightOnline.Database.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="LogInServer.sample.ini" CopyToOutputDirectory="PreserveNewest" />
    <!-- Single configured database migrations, applied automatically on startup -->
    <None Include="..\..\sql\mysql\kn_online\*.sql" Link="sql\kn_online\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
